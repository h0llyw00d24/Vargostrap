<UserControl
    x:Class="Froststrap.Vargostrap.UI.FpsOptimizationPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:gv="using:Froststrap.UI.ViewModels"
    xmlns:vui="clr-namespace:Froststrap.Vargostrap.UI"
    xmlns:ff="clr-namespace:Froststrap.Vargostrap.FastFlags"
    d:DesignHeight="2500"
    d:DesignWidth="1200"
    x:DataType="vui:FpsOptimizationViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="14">

            <!-- Allowlist checker -->
            <ui:FAInfoBar
                Severity="Warning"
                IsOpen="{Binding HasViolations}"
                IsVisible="{Binding HasViolations}"
                IsClosable="False"
                Title="{Binding ViolationsTitle}"
                Message="{Binding ViolationsMessage}"
                Margin="0,0,0,8" />

            <ui:FAInfoBar
                Severity="Error"
                IsOpen="{Binding HasAllowlistError}"
                IsVisible="{Binding HasAllowlistError}"
                IsClosable="False"
                Message="{Binding AllowlistError}"
                Margin="0,0,0,8" />

            <controls:CardExpander
                Header="Roblox FastFlag allowlist"
                Description="{Binding AllowlistStatus}">
                <controls:CardExpander.HeaderContent>
                    <Button Content="Refresh" Command="{Binding RefreshAllowlistCommand}" IsEnabled="{Binding CanRefresh}" />
                </controls:CardExpander.HeaderContent>
                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <TextBlock Classes="hint"
                               Text="Roblox only applies FastFlags on its official allowlist and silently ignores every other flag. Vargostrap checks all your preset and custom flags against the list above and warns you about any that won't work. The list refreshes automatically once a day." />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" Text="Custom source URL" />
                        <TextBox Grid.Column="1" Text="{Binding AllowlistSourceUrl, Mode=TwoWay}"
                                 PlaceholderText="Leave empty to use Froststrap's signed config (recommended)" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Margin="0,4,0,0"
                                   Text="Advanced. An https:// URL returning a JSON array of flag names, or an object with an &quot;Allowed&quot; array. Click Refresh after changing it." />
                    </Grid>
                    <Button Content="View Roblox's official allowlist post"
                            Command="{x:Static gv:GlobalViewModel.OpenWebpageCommand}"
                            CommandParameter="{x:Static vui:FpsOptimizationViewModel.OfficialAllowlistUrl}" />
                </StackPanel>
            </controls:CardExpander>

            <!-- Quick presets -->
            <TextBlock Classes="section" Text="Quick presets" />
            <TextBlock Classes="hint" Text="{Binding ActivePresetText}" />
            <ui:FAInfoBar
                Severity="Success"
                IsOpen="{Binding HasPresetNotice}"
                IsVisible="{Binding HasPresetNotice}"
                IsClosable="False"
                Message="{Binding PresetNotice}"
                Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Presets, Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ff:FpsPreset">
                        <controls:CardExpander Header="{Binding Name}" Description="{Binding Summary}">
                            <controls:CardExpander.HeaderContent>
                                <Button Content="Apply"
                                        Command="{Binding $parent[ItemsControl].((vui:FpsOptimizationViewModel)DataContext).ApplyPresetCommand}"
                                        CommandParameter="{Binding}" />
                            </controls:CardExpander.HeaderContent>
                            <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding Details}" />
                        </controls:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Frame rate -->
            <TextBlock Classes="section" Text="Frame rate" />
            <TextBlock Classes="hint"
                       Text="No FPS-unlock flag is on Roblox's allowlist, so this uses Roblox's own Maximum Frame Rate setting, the same one in the in-game Settings menu. Close Roblox before saving or it may overwrite the change." />

            <controls:OptionControl
                IsVisible="{x:Static vui:FpsOptimizationViewModel.FramerateCapAvailable}"
                Header="Maximum frame rate"
                Description="Highest FPS Roblox will render. Pick your monitor's refresh rate for the smoothest result. Higher values use more power and heat. Unlimited removes the cap in the settings file, but Roblox officially supports up to 240 and may still stop there.">
                <ComboBox MinWidth="200" Padding="10,5"
                          ItemsSource="{x:Static vui:FpsOptimizationViewModel.FramerateCapOptions}"
                          SelectedItem="{Binding SelectedFramerateCap, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vui:FramerateCapOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:OptionControl>
            <TextBlock Classes="hint"
                       IsVisible="{x:Static vui:FpsOptimizationViewModel.SettingsFileLocked}"
                       Text="Roblox's settings file is locked (read-only). Your change is still saved here, and Roblox can't overwrite it in game." />
            <TextBlock Classes="hint"
                       IsVisible="{x:Static vui:FpsOptimizationViewModel.FramerateCapUnavailable}"
                       Text="Roblox's settings file wasn't found. Launch Roblox once, then reopen this page." />

            <!-- Graphics -->
            <TextBlock Classes="section" Text="Graphics" />

            <controls:OptionControl
                Header="Rendering API"
                Description="The graphics system Roblox draws with. Leave it on Default (Direct3D 11) unless you get stutters or crashes. Vulkan can be faster on some AMD and NVIDIA cards. Needs a Roblox restart."
                HelpLink="https://github.com/Meddsam/Froststrap/wiki/A-guide-to-FastFlags#rendering-mode">
                <ComboBox MinWidth="200" Padding="10,5"
                          ItemsSource="{Binding RenderingModeOptions, Mode=OneTime}"
                          SelectedItem="{Binding SelectedRenderingModeItem, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:OptionControl>

            <controls:OptionControl
                Header="Force graphics level"
                Description="Locks Roblox's graphics quality to one level (1 = lowest, 21 = highest) and ignores the in-game slider. Lower is faster. Disabled = use the in-game slider."
                HelpLink="https://github.com/Meddsam/Froststrap/wiki/A-guide-to-FastFlags#override-graphic-level">
                <ComboBox MinWidth="200" Padding="10,5"
                          ItemsSource="{Binding QualityLevels.Keys, Mode=OneTime}"
                          SelectedItem="{Binding SelectedQualityLevel, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={StaticResource EnumNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:OptionControl>

            <controls:OptionControl
                Header="Texture quality"
                Description="Lower texture quality makes surfaces blurrier but uses less video memory and RAM. It helps most on integrated graphics or GPUs with 4 GB of memory or less.">
                <ComboBox MinWidth="200" Padding="10,5"
                          ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}"
                          SelectedItem="{Binding SelectedTextureQuality, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={StaticResource EnumNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:OptionControl>

            <controls:OptionControl
                Header="Anti-aliasing (MSAA)"
                Description="Smooths jagged edges. 1x turns it off for the best FPS. 4x looks smoothest but costs the most.">
                <ComboBox MinWidth="200" Padding="10,5"
                          ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}"
                          SelectedItem="{Binding SelectedMSAALevel, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:OptionControl>

            <controls:OptionControl
                Header="Ignore Windows display scaling"
                Description="If Windows display scaling is above 100%, Roblox renders at full resolution instead of a lower, scaled-up one. Sharper image, slightly lower FPS."
                HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
                <ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
            </controls:OptionControl>

            <!-- Performance tweaks -->
            <TextBlock Classes="section" Text="Performance tweaks" />

            <controls:OptionControl
                Header="Gray sky"
                Description="Replaces the skybox with a plain gray sky. Small FPS gain, mostly on low-end PCs.">
                <ToggleSwitch IsChecked="{Binding GraySky, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="Remove grass"
                Description="Hides terrain grass and stops it from moving. Noticeable FPS gain in games with large grassy maps.">
                <ToggleSwitch IsChecked="{Binding RemoveGrass, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="Pause voxelizer"
                Description="Stops Roblox from recalculating lighting as the world changes. Raises FPS, but lighting and shadows can look wrong after objects move or explode.">
                <ToggleSwitch IsChecked="{Binding PauseVoxelizer, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:CardExpander
                IsExpanded="{Binding Path=LowPolyMeshesEnabled, Mode=OneWay}"
                Classes="NoUserExpansion"
                Header="Low-detail meshes"
                Description="Shows simpler versions of 3D models sooner. Fewer polygons means more FPS. Distant objects look blockier.">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding LowPolyMeshesEnabled, Mode=TwoWay}" />
                </controls:CardExpander.HeaderContent>
                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                               Text="{x:Static resources:Strings.Common_Performance}" />
                    <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding LowPolyMeshesLevel, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Text="{x:Static resources:Strings.Common_Quality}" />
                </Grid>
            </controls:CardExpander>

            <!-- Custom flags -->
            <TextBlock Classes="section" Text="Custom flags" />

            <controls:CardAction
                Icon="FilePenLine"
                Header="Custom FastFlag editor"
                Description="Add, edit, import or remove individual FastFlags. Flags that aren't on the allowlist are flagged above."
                Command="{Binding OpenFastFlagEditorCommand}" />

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
                Description="When off, Vargostrap doesn't write any FastFlags and Roblox runs with its defaults. Your settings here are kept.">
                <ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}"
                Description="Temporarily clears every flag. Switch it back off before saving to undo.">
                <ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
            </controls:OptionControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
